<script>
require(['jquery','Magento_Ui/js/modal/alert'], function ($, uiAlert) {
    $(function () {
        var $form   = $('#tax-calculator-form');
        var $btn    = $('.tax-calculate-btn');
        var $result = $('#tax-result');
        var $sum    = $('#tax-summary');
        var $json   = $('#tax-result-content');
        var $tog    = $('#toggle-json');
        var url     = '<?= $block->escapeJs($block->getCalculateUrl()) ?>';

        var eg = [{"tax_product_code":"OL_OOP_NA","sku":"EXT-001","name":"Online Open Programme","price":10000,"qty":1}];
        $('#line_items').val(JSON.stringify(eg, null, 2));

        $tog.on('click', function () {
            $json.toggle();
            $(this).text($json.is(':visible') ? 'Hide raw JSON' : 'Show raw JSON');
        });

        $form.on('submit', function (e) {
            e.preventDefault();

            try {
                var parsed = JSON.parse($('#line_items').val());
                if (!Array.isArray(parsed) || parsed.length === 0) throw new Error('Must be a non-empty JSON array');
            } catch (err) {
                uiAlert({ title: 'Invalid Line Items', content: 'line_items: ' + err.message });
                return;
            }

            var params = $form.serialize();
            // Optional bool fields — only append when checked; absent = null on server

            $btn.prop('disabled', true);
            $result.removeClass('success warning error');
            $sum.empty();
            $json.hide().text('');
            $tog.hide();

            $.ajax({
                url: url, type: 'POST', data: params, showLoader: true,
                success: function (r) {
                    $btn.prop('disabled', false);
                    $result.addClass(r.status || 'error');
                    var cur  = r.currency || '';
                    var msg  = r.message ? '<br><small style="color:#c00">' + $('<div>').text(r.message).html() + '</small>' : '';
                    var fb   = r.fallback_applied ? ' <small>(fallback)</small>' : '';
                    $sum.html(
                        card('Status',      (r.status||'').toUpperCase() + msg) +
                        card('Tax Rate',    (r.tax_rate    != null ? r.tax_rate    : '-') + '%' + fb) +
                        card('Subtotal',    (r.subtotal    != null ? r.subtotal    : '-') + ' ' + cur) +
                        card('Tax Amount',  (r.tax_amount  != null ? r.tax_amount  : '-') + ' ' + cur) +
                        card('Grand Total', (r.grand_total != null ? r.grand_total : '-') + ' ' + cur) +
                        card('Tax Comment', r.tax_comment || '—')
                    );
                    $json.text(JSON.stringify(r, null, 2));
                    $tog.show();
                },
                error: function (xhr, s, err) {
                    $btn.prop('disabled', false);
                    uiAlert({ title: 'Request Failed', content: 'Error: ' + err });
                }
            });
        });

        function card(label, val) {
            return '<div class="summary-card"><h4>' + label + '</h4><p>' + val + '</p></div>';
        }
    });
});

function updateSkuPreview() {
    var le  = document.getElementById('legal_entity').value || '{legalEntity}';
    var pdl = document.getElementById('programme_delivery_location').value || '{deliveryLocation}';
    document.getElementById('sku-preview').textContent =
        le + '_{tax_product_code}_' + pdl;
}
</script>
