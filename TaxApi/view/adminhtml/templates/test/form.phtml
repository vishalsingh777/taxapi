<script>
require(['jquery','Magento_Ui/js/modal/alert'], function ($, uiAlert) {
    $(function () {
        var $form = $('#tax-calculator-form');
        var $btn  = $('.tax-calculate-btn');
        var $res  = $('#tax-result');
        var $sum  = $('#tax-summary');
        var $json = $('#tax-result-content');
        var $tog  = $('#toggle-json');
        var url   = '<?= $block->escapeJs($block->getCalculateUrl()) ?>';

        var eg = [{"product_family":"OOP","delivery_mode":"Online","duration":null,"name":"Online Open Programme","price":10000,"qty":1}];
        $('#line_items').val(JSON.stringify(eg, null, 2));

        $tog.on('click', function () {
            $json.toggle();
            $(this).text($json.is(':visible') ? 'Hide raw JSON' : 'Show raw JSON');
        });

        $form.on('submit', function (e) {
            e.preventDefault();
            try {
                var p = JSON.parse($('#line_items').val());
                if (!Array.isArray(p) || !p.length) throw new Error('Must be a non-empty JSON array');
            } catch (err) { uiAlert({ title: 'Invalid Line Items', content: err.message }); return; }

            $btn.prop('disabled', true);
            $res.removeClass('success warning error');
            $sum.empty(); $json.hide().text(''); $tog.hide();

            $.ajax({
                url: url, type: 'POST', data: $form.serialize(), showLoader: true,
                success: function (r) {
                    $btn.prop('disabled', false);
                    $res.addClass(r.status || 'error');
                    var cur = r.currency || '';
                    var msg = r.message ? '<br><small style="color:#c00">' + $('<div>').text(r.message).html() + '</small>' : '';
                    var fb  = r.fallback_applied ? ' <small>(fallback)</small>' : '';
                    $sum.html(
                        card('Status',      (r.status||'').toUpperCase() + msg) +
                        card('Tax Rate',    (r.tax_rate    != null ? r.tax_rate    : '-') + '%' + fb) +
                        card('Subtotal',    (r.subtotal    != null ? r.subtotal    : '-') + ' ' + cur) +
                        card('Tax Amount',  (r.tax_amount  != null ? r.tax_amount  : '-') + ' ' + cur) +
                        card('Grand Total', (r.grand_total != null ? r.grand_total : '-') + ' ' + cur) +
                        card('Tax Comment', r.tax_comment || '—')
                    );
                    $json.text(JSON.stringify(r, null, 2)); $tog.show();
                },
                error: function (xhr, s, err) { $btn.prop('disabled', false); uiAlert({ title: 'Request Failed', content: err }); }
            });
        });

        function card(l, v) { return '<div class="summary-card"><h4>' + l + '</h4><p>' + v + '</p></div>'; }
    });
});

function onEntityOrTypeChange() {
    var le  = document.getElementById('legal_entity').value;
    var ct  = document.getElementById('customer_type').value;
    var sgp = le === 'SGP';
    var b2b = ct === 'B2B';
    var b2c = ct === 'B2C';

    document.getElementById('row-tax-status').style.display      = b2b ? '' : 'none';
    document.getElementById('row-gst-declaration').style.display = (sgp && b2b) ? '' : 'none';
    document.getElementById('row-outside-sg').style.display      = (sgp && b2c) ? '' : 'none';

    if (!sgp || !b2b) document.getElementById('gst_declaration_accepted').checked = false;
    if (!sgp || !b2c) document.getElementById('outside_sg').checked = true;

    updateSkuPreview();
}

function updateSkuPreview() {
    var le  = document.getElementById('legal_entity').value || '{legalEntity}';
    var pdl = document.getElementById('programme_delivery_location').value || '{pdl}';
    document.getElementById('sku-preview').textContent = le + '_{OL|IP}_{family}_{GT1W|LT1W|NA}_' + pdl;
}
</script>
